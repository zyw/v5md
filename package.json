{
  "name": "v5md",
  "private": true,
  "workspaces": [
    "packages/*",
    "playground-vue",
    "playground-react"
  ],
  "scripts": {
    "build": "npm run build -w @v5md/core && npm run build -w @v5md/view && npm run build -w @v5md/vue && npm run build -w @v5md/react",
    "test": "vitest run",
    "dev:vue": "npm run dev -w playground-vue",
    "dev:react": "npm run dev -w playground-react"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
