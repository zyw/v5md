{
  "name": "@v5md/view",
  "version": "0.0.2",
  "description": "基于 contenteditable 的所见即所得 Markdown 编辑器",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js",
    "./dist/theme.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://onedev.v5ai.xin/v5md.git",
    "directory": "packages/view"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node scripts/build-theme.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@v5md/core": "0.0.2",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
